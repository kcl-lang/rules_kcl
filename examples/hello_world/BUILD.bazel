load("@org_kcl_lang_rules_kcl//kcl:defs.bzl", "kcl_run")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_file")

kcl_run(
    name = "hello.yaml.write",
    files = ["main.k"],
    format = "yaml",
)

# Independent targets. `bazel build //...` schedules these together so a shared
# package cache would serialize them.
kcl_run(
    name = "parallel_a",
    files = ["parallel_a.k"],
    format = "yaml",
)

kcl_run(
    name = "parallel_b",
    files = ["parallel_b.k"],
    format = "yaml",
)

write_source_file(
    name = "hello.yaml.update",
    in_file = ":hello.yaml.write",
    out_file = "hello.yaml",
    suggested_update_target = "//:hello.yaml.update",
)
